<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Tapestry.Contracts\Tapestry.Contracts.csproj" />
    <ProjectReference Include="..\Tapestry.Shared\Tapestry.Shared.csproj" />
    <ProjectReference Include="..\Tapestry.Engine\Tapestry.Engine.csproj" />
    <ProjectReference Include="..\Tapestry.Networking\Tapestry.Networking.csproj" />
    <ProjectReference Include="..\Tapestry.Scripting\Tapestry.Scripting.csproj" />
    <ProjectReference Include="..\Tapestry.Data\Tapestry.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />

    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\packs\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="packs" />
    <Content Include="..\..\server.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\**\*" Exclude="..\..\data\saves\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="data" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tapestry.Engine.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

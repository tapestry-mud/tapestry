{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "bolt",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "Explore Traces",
      "tooltip": "Open Jaeger trace search in Explore",
      "type": "link",
      "url": "/explore?schemaVersion=1&panes=%7B%22one%22:%7B%22datasource%22:%22jaeger%22,%22queries%22:%5B%7B%22refId%22:%22A%22,%22datasource%22:%7B%22type%22:%22jaeger%22,%22uid%22:%22jaeger%22%7D,%22queryType%22:%22search%22,%22service%22:%22tapestry%22,%22limit%22:20%7D%5D%7D%7D&orgId=1"
    },
    {
      "asDropdown": false,
      "icon": "file-alt",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "Explore Logs",
      "tooltip": "Open Loki log search in Explore (trace links clickable here)",
      "type": "link",
      "url": "/explore?schemaVersion=1&panes=%7B%22one%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22tapestry%5C%22%7D%22%7D%5D%7D%7D&orgId=1"
    }
  ],
  "panels": [
    {
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "title": "Active Connections",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(tapestry_connections_active)",
          "legendFormat": "connections"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "title": "Commands / sec",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(tapestry_tick_commands_processed_total[1m]))",
          "legendFormat": "cmd/s"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "title": "Events / sec",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(tapestry_tick_events_processed_total[1m]))",
          "legendFormat": "evt/s"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 8,
      "title": "Exceptions / sec",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(dotnet_exceptions_total[1m]))",
          "legendFormat": "exceptions/s"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 9,
      "title": "Memory",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(dotnet_process_memory_working_set_bytes)",
          "legendFormat": "working set"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 209715200 },
              { "color": "red", "value": 524288000 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 10,
      "title": "Tick Rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(tapestry_tick_duration_ms_milliseconds_count[1m]))",
          "legendFormat": "ticks/s"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 1 }, "overrides": [] }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "id": 4,
      "title": "Tick Duration",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(tapestry_tick_duration_ms_milliseconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tapestry_tick_duration_ms_milliseconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tapestry_tick_duration_ms_milliseconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "id": 5,
      "title": "Command Duration",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(tapestry_command_duration_ms_milliseconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tapestry_command_duration_ms_milliseconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tapestry_command_duration_ms_milliseconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "id": 6,
      "title": "GC Allocation Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(dotnet_gc_heap_allocated_bytes_total[1m]))",
          "legendFormat": "alloc/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 20,
      "title": "Runaway-growth diagnostics (world census + mob-ai / handler phases)",
      "type": "row",
      "collapsed": false,
      "panels": []
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "id": 11,
      "title": "World Entities by Type",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Live entity count by type. A climbing type names the runaway source (npc=spawn, item=distribution, container=corpse).",
      "targets": [
        { "expr": "sum by (type) (tapestry_world_entities)", "legendFormat": "{{type}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
      "id": 12,
      "title": "Property Census",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Property-bag totals. total climbing with flat entity count = a few entities accumulating; max single spiking = one entity. Leading suspect for the autosave disk firehose.",
      "targets": [
        { "expr": "sum(tapestry_world_properties_total)", "legendFormat": "total entries", "refId": "A" },
        { "expr": "max(tapestry_world_max_entity_properties)", "legendFormat": "max single entity", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "id": 13,
      "title": "Tag Index Size",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Tag-index size (the SwapTagBuffers / pre_tick cost driver). Climbing tags = a tag leak; flat tags with climbing memberships = entity growth.",
      "targets": [
        { "expr": "sum(tapestry_world_tag_index_tags)", "legendFormat": "distinct tags", "refId": "A" },
        { "expr": "sum(tapestry_world_tag_index_entries)", "legendFormat": "memberships", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 21 },
      "id": 14,
      "title": "mob-ai Phase Time (p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Per-phase mob-ai time. Turns 'mob-ai took 25s' into which phase: scan (entity count) vs behavior (Jint) vs publish (a subscriber) vs disposition. Note: phases do not sum to mob-ai wall time (per-mob loop overhead is uninstrumented).",
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le, phase) (rate(tapestry_mob_ai_phase_ms_milliseconds_bucket[1m])))", "legendFormat": "{{phase}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 21 },
      "id": 15,
      "title": "Handler Wall Time (p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Per-handler wall-clock time per tick. Pair with CPU time: wall >> cpu = the handler was preempted (GC/scheduling); wall ~= cpu = genuinely cpu-bound.",
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le, handler) (rate(tapestry_tick_handler_wall_ms_milliseconds_bucket[1m])))", "legendFormat": "{{handler}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 21 },
      "id": 16,
      "title": "Handler CPU Time (p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Per-handler thread CPU time per tick. Compare to Handler Wall Time to classify a slow handler as cpu-bound vs preempted.",
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le, handler) (rate(tapestry_tick_handler_cpu_ms_milliseconds_bucket[1m])))", "legendFormat": "{{handler}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 29 },
      "id": 7,
      "title": "Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "expr": "{service_name=\"tapestry\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "id": 21,
      "title": "Mob-AI budget exhausted /min",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(tapestry_mob_ai_budget_exhausted_total[5m]) * 60", "legendFormat": "exhausted/min", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "id": 22,
      "title": "Mob-AI cursor lag (deferred mobs)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "tapestry_mob_ai_cursor_lag", "legendFormat": "deferred", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 51 },
      "id": 23,
      "title": "Mob-AI invocation-cap strikes by behavior (1h)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (behavior) (increase(tapestry_mob_ai_invocation_cap_total[1h]))", "legendFormat": "{{behavior}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 51 },
      "id": 24,
      "title": "Mob-AI quarantines (behavior/pack)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (behavior, pack) (increase(tapestry_mob_ai_quarantine_total[1h]))", "legendFormat": "{{behavior}} ({{pack}})", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 59 },
      "id": 30,
      "title": "LLM Recommend (Oracle)",
      "type": "row",
      "collapsed": false,
      "panels": []
    },
    {
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 60 },
      "id": 31,
      "title": "Recommend Latency (p50 / p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "LLM recommend call latency by field. p50 = typical; p95 = tail. Elevated tail with low in-flight = LLM cold start or timeout.",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, field) (rate(tapestry_recommend_duration_ms_milliseconds_bucket[5m])))",
          "legendFormat": "p50 {{field}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, field) (rate(tapestry_recommend_duration_ms_milliseconds_bucket[5m])))",
          "legendFormat": "p95 {{field}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "gridPos": { "h": 8, "w": 6, "x": 10, "y": 60 },
      "id": 32,
      "title": "Recommend In-Flight",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Concurrent in-flight LLM recommend calls. Sustained nonzero at low traffic = LLM is slow or hanging.",
      "targets": [
        {
          "expr": "sum(tapestry_recommend_in_flight)",
          "legendFormat": "in-flight",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 60 },
      "id": 33,
      "title": "Recommend Throughput by Outcome",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Recommend call rate per minute by outcome (ok/empty/fault). Climbing fault = LLM errors; climbing empty = prompt needs tuning.",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(tapestry_recommend_total_total[5m])) * 60",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ],
  "schemaVersion": 39,
  "tags": ["tapestry", "observability"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "Loki", "value": "Loki" }
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "title": "Tapestry Overview",
  "uid": "tapestry-overview",
  "version": 5
}
